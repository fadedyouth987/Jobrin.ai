# Canonical Jobrin.ai staging URLs
NODE_ENV=test
# Deployment stage drives staging secret enforcement without pretending this is production.
DEPLOYMENT_STAGE=staging
APP_URL=https://jobrin-ai-staging.nexgen-studio.workers.dev
CORS_ORIGINS=https://jobrin-ai-staging.nexgen-studio.workers.dev
TRUST_PROXY=1
PORT=3000

# Public Supabase staging values
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_STAGING_SUPABASE_PUBLISHABLE_KEY

# Server secrets - configure as Cloudflare Worker staging secrets, never commit real values
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_CLOUDFLARE_STAGING
STRIPE_SECRET_KEY=rk_test_REPLACE_IN_CLOUDFLARE_STAGING
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_IN_CLOUDFLARE_STAGING
STRIPE_PRICE_STARTER=price_REPLACE_IN_CLOUDFLARE_STAGING
STRIPE_PRICE_GROWTH=price_REPLACE_IN_CLOUDFLARE_STAGING
STRIPE_PRICE_OPERATOR=price_REPLACE_IN_CLOUDFLARE_STAGING
TWILIO_ACCOUNT_SID=AC_REPLACE_IN_CLOUDFLARE_STAGING
TWILIO_AUTH_TOKEN=REPLACE_IN_CLOUDFLARE_STAGING
TWILIO_PHONE_NUMBER=+61_REPLACE_IN_CLOUDFLARE_STAGING
OPENAI_API_KEY=REPLACE_IN_CLOUDFLARE_STAGING
OPENAI_MODEL=gpt-5-mini

# Transactional email staging values
EMAIL_API_KEY=REPLACE_IN_CLOUDFLARE_STAGING
EMAIL_FROM=Jobrin.ai Staging <noreply@staging.jobrin.ai>

REQUIRE_AAL2_SENSITIVE=true
REQUIRE_EMAIL_VERIFICATION=true
