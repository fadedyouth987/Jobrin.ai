{
  "name": "jobryn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca --import tsx node-server.ts",
    "build": "vite build && esbuild node-server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:staging": "node scripts/assert-browser-config.mjs staging && npm run build",
    "build:production": "node scripts/assert-browser-config.mjs production && npm run build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/security-check.mjs",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run security:check && npm run build",
    "setup:check": "node scripts/setup-check.mjs",
    "cf:typegen": "wrangler types",
    "cf:dry-run": "npm run build:staging && wrangler deploy --dry-run --env staging",
    "cf:deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "cf:deploy:production": "npm run build:production && wrangler deploy --env=\"\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "stripe": "22.4.0",
    "three": "^0.185.1",
    "twilio": "6.1.0",
    "vite": "^6.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.127.0"
  }
}
