# Canonical Jobryn production URLs
NODE_ENV=production
APP_URL=https://jobryn.org
CORS_ORIGINS=https://jobryn.org,https://www.jobryn.org
TRUST_PROXY=1
PORT=3000

# Public Supabase values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server secrets — configure in Hostinger, never commit real values
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_HOSTINGER
STRIPE_SECRET_KEY=rk_live_REPLACE_IN_HOSTINGER
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_IN_HOSTINGER
STRIPE_PRICE_STARTER=price_REPLACE_IN_HOSTINGER
STRIPE_PRICE_GROWTH=price_REPLACE_IN_HOSTINGER
STRIPE_PRICE_OPERATOR=price_REPLACE_IN_HOSTINGER
TWILIO_ACCOUNT_SID=AC_REPLACE_IN_HOSTINGER
TWILIO_AUTH_TOKEN=REPLACE_IN_HOSTINGER
TWILIO_PHONE_NUMBER=+61_REPLACE_IN_HOSTINGER
OPENAI_API_KEY=REPLACE_IN_HOSTINGER
OPENAI_MODEL=gpt-5-mini

REQUIRE_AAL2_SENSITIVE=true
REQUIRE_EMAIL_VERIFICATION=true
